# MILLIYBIZ.NEWS — site, CRM and robot editor (news.milliybiz.uz)
# Folder: /srv/projects/milliybiz-news   nginx: /etc/nginx/sites-available/news.milliybiz.uz.conf
[Unit]
Description=MILLIYBIZ.NEWS — news site, CRM and robot (news.milliybiz.uz)
After=network-online.target
Wants=network-online.target

[Service]
User=mnews
Group=mnews
WorkingDirectory=/srv/projects/milliybiz-news/app
Environment=NODE_ENV=production
Environment=PORT=4200
Environment=HOST=127.0.0.1
# IPv6 on this VPS does not route: always try IPv4 first (Telegram API, news sources)
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
MemoryMax=200M
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/srv/projects/milliybiz-news/app/data /srv/projects/milliybiz-news/app/public/uploads

[Install]
WantedBy=multi-user.target
